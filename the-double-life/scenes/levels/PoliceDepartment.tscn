[sub_resource type="GDScript" id="GDScript_hud"]
script/source = "extends CanvasLayer

@onready var dialogue_box: PanelContainer = $DialogueBox
@onready var dialogue_label: Label = $DialogueBox/Label

func _ready() -> void:
	for node in get_tree().get_nodes_in_group(\"interactables\"):
		node.interacted.connect(_on_interacted)

func _on_interacted(_prompt: String, dialogue: String, clue: String, go_map: bool) -> void:
	if go_map:
		get_tree().change_scene_to_file(\"res://scenes/ui/GreyhavenMap.tscn\")
		return
	dialogue_box.visible = true
	var msg := dialogue
	if clue != \"\":
		msg += \"\\n[Clue added to Journal: \" + clue + \"]\"
	dialogue_label.text = msg

func _unhandled_input(event: InputEvent) -> void:
	if dialogue_box.visible and event.is_action_pressed(\"ui_cancel\"):
		dialogue_box.visible = false
"

